# ---------------------------------------------------------------
# Clerk (https://dashboard.clerk.com -> API Keys)
# ---------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Contentful (https://app.contentful.com)
# ---------------------------------------------------------------
# Space ID: Settings -> General settings (or the space selector)
CONTENTFUL_SPACE_ID=your_space_id
# Delivery API key (published content): Settings -> API keys ->
# "Content delivery/preview API tokens". Per-space; the two keys below are
# the only ones that appear on that page.
CONTENTFUL_ACCESS_TOKEN=your_content_delivery_api_token

# Optional: draft content for Preview mode
CONTENTFUL_PREVIEW_TOKEN=your_content_preview_api_token
# Optional: NOT a Contentful value — an arbitrary phrase you make up yourself,
# used only if you later wire a preview/revalidate webhook.
CONTENTFUL_PREVIEW_SECRET=any_phrase_you_make_up
CONTENTFUL_ENVIRONMENT=master

# ---------------------------------------------------------------
# Contentful CLI / codegen (contentful:import, contentful:codegen)
# ---------------------------------------------------------------
# This is NOT an API key and does NOT appear on the API keys page.
# It is a Personal Access Token (starts with "CFPAT-") that you must GENERATE:
#   Settings -> CMA tokens  (or profile avatar -> Account settings -> CMA tokens)
#   https://app.contentful.com/account/profile/cma_tokens
# -> "Create personal access token" -> name it -> Generate -> COPY IT NOW
# (it is shown only once; if lost, revoke and create a new one).
# It inherits your account's permissions, so it works on every space you can open.
CONTENTFUL_MANAGEMENT_TOKEN=CFPAT-your_generated_personal_access_token